# Development example only. Replace the API key before exposing the service.
PAYMENTS_API_KEY=local-development-key-change-me
PAYMENTS_WEBHOOK_ALLOWED_ORIGINS=["http://127.0.0.1:8081"]
# Development database credentials. DatabaseSettings constructs the URL safely.
PAYMENTS_DATABASE_HOST=127.0.0.1
PAYMENTS_DATABASE_PORT=55432
PAYMENTS_DATABASE_USER=payments
PAYMENTS_DATABASE_PASSWORD=local-development-db-password
PAYMENTS_DATABASE_NAME=payments
# The worker uses these locally; Compose overrides host and port inside containers.
PAYMENTS_BROKER_HOST=127.0.0.1
PAYMENTS_BROKER_PORT=5673
PAYMENTS_BROKER_USER=payments
PAYMENTS_BROKER_PASSWORD=local-development-broker-password
PAYMENTS_BROKER_VHOST=/
PAYMENTS_RELAY_PUBLISH_TIMEOUT=5
PAYMENTS_RELAY_POLL_INTERVAL=1
PAYMENTS_PROCESSING_TIMEOUT=10
PAYMENTS_WEBHOOK_TIMEOUT=5
PAYMENTS_CONSUMER_REQUEUE_DELAY=1
